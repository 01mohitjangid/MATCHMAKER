# ---------------------------------------------------------------------------
# Firebase (Firestore) configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Firebase
# project: Firebase Console → Project settings → "Your apps" → Web app → Config.
#
# These NEXT_PUBLIC_* keys are exposed to the browser by design — Firebase
# access is controlled by Firestore security rules, not by secrecy.
#
# After filling these in, run:  npm run seed   (uploads the demo data)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: which backend the data layer uses.
#   (left unset) → Firestore when the keys above are present, else in-memory
# DATA_SOURCE=firestore

# Secret used to HMAC-sign the session cookie. Set a long random value in
# production (e.g. `openssl rand -base64 32`). A dev fallback is used if unset.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# AI (email-intro generation) — OpenAI-compatible. Defaults to Groq (free).
# ---------------------------------------------------------------------------
# Get a free key at https://console.groq.com → API Keys.
# If unset, the app falls back to a templated intro (still fully works).
GROQ_API_KEY=
# Advanced: override to use OpenAI / OpenRouter / Gemini instead.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
